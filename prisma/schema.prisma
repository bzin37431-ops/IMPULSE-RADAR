generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  MANAGER
  AGENT
  VIEWER
}
enum LeadStatus {
  NOVO
  PESQUISADO
  PRONTO_PARA_CONTATO
  CONTATADO
  RESPONDEU
  INTERESSADO
  REUNIAO
  PROPOSTA
  CLIENTE
  SEM_INTERESSE
  NAO_CONTATAR
}
enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}
enum MessageDirection {
  INBOUND
  OUTBOUND
}
enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  INTERACTIVE
  TEMPLATE
}
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}
enum CampaignStatus {
  DRAFT
  AWAITING_APPROVAL
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}
enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  leads Lead[] @relation("assigned")
  notes LeadNote[]
  tasks Task[]
  auditLogs AuditLog[]
}
model Lead {
  id String @id @default(cuid())
  name String
  company String?
  phone String?
  normalizedPhone String? @unique
  email String?
  instagram String?
  googleMaps String?
  site String?
  city String?
  state String?
  niche String?
  source String?
  observations String?
  nextFollowUpAt DateTime?
  lastContactAt DateTime?
  siteModelSent String?
  proposedValue Decimal? @db.Decimal(12, 2)
  proposalDate DateTime?
  status LeadStatus @default(NOVO)
  assignedUserId String?
  assigned User? @relation("assigned", fields: [assignedUserId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes LeadNote[]
  history LeadHistory[]
  conversations Conversation[]
  consent Consent?
  optOut OptOut?
  tasks Task[]
  campaignRecipients CampaignRecipient[]
  @@index([normalizedPhone])
  @@index([city, niche])
}
model LeadNote {
  id String @id @default(cuid())
  leadId String
  userId String
  body String
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}
model LeadHistory {
  id String @id @default(cuid())
  leadId String
  type String
  details Json?
  userId String?
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
}
model Conversation {
  id String @id @default(cuid())
  leadId String
  status String @default("OPEN")
  lastMessageAt DateTime?
  windowOpenUntil DateTime?
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages Message[]
}
model Message {
  id String @id @default(cuid())
  conversationId String
  providerMessageId String? @unique
  direction MessageDirection
  type MessageType
  content String
  templateName String?
  status MessageStatus @default(QUEUED)
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  sentAt DateTime?
  deliveredAt DateTime?
  readAt DateTime?
  failedAt DateTime?
  errorCode String?
  errorMessage String?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}
model Campaign {
  id String @id @default(cuid())
  name String
  templateName String
  segment Json
  createdBy String
  createdAt DateTime @default(now())
  scheduledAt DateTime?
  status CampaignStatus @default(DRAFT)
  recipients CampaignRecipient[]
}
model CampaignRecipient {
  id String @id @default(cuid())
  campaignId String
  leadId String
  status String @default("PENDING")
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id])
  @@unique([campaignId, leadId])
}
model Template {
  id String @id @default(cuid())
  name String @unique
  language String
  category String
  status TemplateStatus
  updatedAt DateTime @updatedAt
}
model Consent {
  id String @id @default(cuid())
  leadId String @unique
  status ConsentStatus @default(UNKNOWN)
  source String?
  date DateTime?
  text String?
  proof String?
  category String?
  formVersion String?
  ip String?
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}
model OptOut {
  id String @id @default(cuid())
  leadId String @unique
  blockedAt DateTime @default(now())
  reason String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}
model Task {
  id String @id @default(cuid())
  leadId String
  title String
  description String?
  dueDate DateTime?
  assignedTo String?
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [assignedTo], references: [id])
}
model WebhookEvent {
  id String @id @default(cuid())
  eventId String @unique
  timestamp DateTime
  payloadHash String
  status String
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String?
  timestamp DateTime @default(now())
  ip String?
  metadata Json?
  user User? @relation(fields: [userId], references: [id])
  @@index([timestamp])
}
model SystemSetting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}
