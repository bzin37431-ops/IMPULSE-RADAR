{
  "name": "impulse-whatsapp-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Impulse WhatsApp CRM using only the official Meta WhatsApp Cloud API.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite --host 0.0.0.0\"",
    "build": "prisma generate && tsc -p tsconfig.json && vite build",
    "start": "node dist/src/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-cnpj": "tsx src/receitaCnpjImportCli.ts",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "6.12.0",
    "@types/unzipper": "^0.10.11",
    "bullmq": "^5.76.1",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "maplibre-gl": "^6.10.0",
    "pino": "^9.9.0",
    "unzipper": "^0.12.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "prisma": "6.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true
  }
}
